		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.5",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"dexie": "^4.4.4",
